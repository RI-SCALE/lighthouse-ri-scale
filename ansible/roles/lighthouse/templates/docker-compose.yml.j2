services:

  # ---------------------------------------------------------------------------
  # PostgreSQL — persistent storage for Lighthouse
  # Credentials are supplied via .env (rendered from Ansible Vault).
  # ---------------------------------------------------------------------------
  postgres:
    image: {{ postgres_image }}
    container_name: ta-postgres
    restart: unless-stopped
    env_file: .env
    environment:
      POSTGRES_USER: "${POSTGRES_USER}"
      POSTGRES_DB: "${POSTGRES_DB}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks: [ta-net]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  caddy:
    image: {{ caddy_image }}
    container_name: ta-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - ./caddy/data:/data
      - ./caddy/config:/config
      - caddy_logs:/var/log/caddy
    networks: [ta-net]
    depends_on:
      - lighthouse

  # ---------------------------------------------------------------------------
  # Lighthouse — OpenID Federation Trust Anchor ({{ lighthouse_image }})
  # Storage credentials passed via LH_STORAGE_DSN environment variable.
  # Port 7672: main server (proxied by Caddy).
  # Port 7673: Admin API — loopback only; access via SSH tunnel.
  # ---------------------------------------------------------------------------
  lighthouse:
    image: {{ lighthouse_image }}
    container_name: ta-lighthouse
    restart: unless-stopped
    env_file: .env
    environment:
      LH_STORAGE_DSN: "${LH_STORAGE_DSN}"
    ports:
      - "127.0.0.1:7672:7672"
      - "127.0.0.1:7673:7673"
    volumes:
      - ./lighthouse/config.yaml:/config.yaml:ro
      - ./lighthouse/data/signing:/data/signing
    networks: [ta-net]
    depends_on:
      postgres:
        condition: service_healthy

volumes:
  caddy_logs:
  postgres_data:

networks:
  ta-net:
    name: ta-net
