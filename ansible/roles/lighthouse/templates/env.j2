# .env — Docker Compose environment file
# Rendered by Ansible from Vault secrets. NEVER commit this file.
#
# PostgreSQL credentials (consumed by the postgres service).
POSTGRES_USER={{ lighthouse_pg_user }}
POSTGRES_DB={{ lighthouse_pg_db }}
POSTGRES_PASSWORD={{ vault_postgres_password }}

# Lighthouse storage DSN — full PostgreSQL connection string.
# Format: host=hostname user=username password=password dbname=database port=5432
LH_STORAGE_DSN=host=ta-postgres user={{ lighthouse_pg_user }} password={{ vault_postgres_password }} dbname={{ lighthouse_pg_db }} port=5432 sslmode=disable
