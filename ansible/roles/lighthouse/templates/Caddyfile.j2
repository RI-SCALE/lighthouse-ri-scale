# Caddy automatically obtains and renews TLS certificates via Let's Encrypt
# (ACME HTTP-01 challenge on port 80, served certificate on port 443).
# The VM must be reachable on both ports from the internet for ACME to work.

{{ lighthouse_entity_id | regex_replace('^https://', '') }} {

    # Block the legacy admin enrollment endpoint from the public internet.
    respond /enroll 403

    # Block the Admin API from the public internet (defense-in-depth).
    # The Admin API runs on port 7673 bound to loopback, so it is not normally
    # routed through Caddy. This rule guards against accidental misconfiguration.
    # Access via SSH tunnel: ssh -L 7673:localhost:7673 user@host
    respond /api/v1/admin* 403

    # Reverse-proxy everything to Lighthouse
    reverse_proxy lighthouse:7672 {
        # Pass real client IP so Lighthouse can log and rate-limit correctly
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Security headers
    header {
        # Prevent click-jacking
        X-Frame-Options "DENY"
        # HSTS — only enable after you are confident HTTPS works
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    # Structured access log
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 10
        }
        format json
    }
}
