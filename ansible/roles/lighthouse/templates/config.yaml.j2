server:
  port: 7672
  # Lighthouse runs behind Caddy (reverse proxy) — TLS is terminated there.
  # Subordinate management is done via lhcli inside the container:
  #   docker exec ta-lighthouse /lhcli -c /config.yaml subordinates add <entity_id>
  trusted_proxies:
    - "172.16.0.0/12"   # default Docker bridge range
    - "127.0.0.1/32"

logging:
  level: "info"

signing:
  alg: ES256
  key_dir: "/data/signing"
  # On first Ansible run (no keys present): true so Lighthouse generates them.
  # On subsequent runs: false so the already-generated keys are never replaced.
  # The ansible task flips this automatically based on whether the key exists.
  auto_generate_keys: {{ 'false' if signing_key.stat.exists else 'true' }}
  automatic_key_rollover:
    enabled: false   # enable only after the initial key has been distributed
                     # to federation members out-of-band

storage:
  backend: badger
  data_dir: "/data/storage"

federation_data:
  # entity_id MUST be the exact public HTTPS URL — rendered by Ansible.
  entity_id: "{{ lighthouse_entity_id }}"

  # As a Trust Anchor we have no superior — authority_hints is omitted.

  configuration_lifetime: "1d"

  federation_entity_metadata:
    organization_name: "GRNET – Greek Research and Technology Network"
    display_name: "RI Federation Trust Anchor (DEP)"
    description: >
      Development/testing Trust Anchor for the Research Infrastructure
      OpenID Federation operated by GRNET.
    contacts:
      - "aai-support@grnet.gr"
    homepage_uri: "https://aai.grnet.gr"

endpoints:
  fetch:
    path: "/fetch"
    statement_lifetime: "7d"

  list:
    path: "/list"

  resolve:
    path: "/resolve"
    allowed_trust_anchors:
      - "{{ lighthouse_entity_id }}"
    grace_period: "1h"
    time_elapsed_grace_factor: 0.75

  enroll_request:
    path: "/enroll-request"

  enroll:
    # Admin-only enrollment endpoint — runs inside the server process.
    # NOT exposed publicly — Caddy blocks it. Access via SSH tunnel only:
    #   ssh -L 7672:localhost:7672 <user>@<host>
    #   curl "http://localhost:7672/enroll?sub=https://example.org/entity"
    path: "/enroll"
