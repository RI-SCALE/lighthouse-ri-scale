server:
  port: 7672
  # Lighthouse runs behind Caddy (reverse proxy) — TLS is terminated there.
  trusted_proxies:
    - "172.16.0.0/12"   # default Docker bridge range
    - "127.0.0.1/32"

logging:
  internal:
    level: "debug"
    stderr: true

# Top-level entity_id (LightHouse 0.20.x format).
entity_id: "{{ lighthouse_entity_id }}"

signing:
  kms: filesystem
  # Public keys in PostgreSQL — set during initial deploy and correct post-migration.
  # lhmigrate keys-kms stores migrated public keys in DB (--pks-type=db);
  # fresh deployments with auto_generate_keys: true also write to DB automatically.
  pk_backend: db
  # On first Ansible run (no keys present): true so Lighthouse generates them.
  # On subsequent runs: false so existing keys are never replaced.
  auto_generate_keys: {{ 'false' if signing_key.stat.exists else 'true' }}
  filesystem:
    key_dir: "/data/signing"

storage:
  driver: postgres
  debug: true
  dsn: "host=ta-postgres user={{ lighthouse_pg_user }} dbname={{ lighthouse_pg_db }} port=5432 sslmode=disable"
  # Password is injected via LH_STORAGE_DSN environment variable which overrides this

# ---------------------------------------------------------------------------
# Admin API — on a separate port (7673) so it is network-isolated from the
# main federation server. Caddy never proxies to this port.
# Access via SSH tunnel: ssh -L 7673:localhost:7673 user@host
# On first start, create the initial admin user with:
#   curl -X POST http://localhost:7673/api/v1/admin/users \
#     -H 'Content-Type: application/json' \
#     -d '{"username":"admin","password":"<strong-password>"}'
# ---------------------------------------------------------------------------
api:
  admin:
    enabled: true
    users_enabled: true
    port: 7673

# ---------------------------------------------------------------------------
# Statistics — enabled.
# ---------------------------------------------------------------------------
stats:
  enabled: true
  buffer:
    size: 10000
    flush_interval: "10s"
    flush_threshold: 0.8
  capture:
    client_ip: true
    user_agent: true
    query_params: true
  retention:
    detailed_days: 90
    aggregated_days: 365

endpoints:
  fetch:
    path: "/fetch"

  list:
    path: "/list"

  resolve:
    path: "/resolve"
    allowed_trust_anchors:
      - "{{ lighthouse_entity_id }}"
    grace_period: "1h"
    time_elapsed_grace_factor: 0.75

  enroll_request:
    path: "/enroll-request"

  enroll:
    # Legacy admin enrollment path — kept for backward compat.
    # Prefer the Admin API (port 7673) for managing subordinates.
    # Caddy blocks this path from the public internet.
    path: "/enroll"
