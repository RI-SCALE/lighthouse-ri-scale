# The actual .env (with real values) must NOT be committed.
.env

# Ansible Vault file with secrets.
ansible/group_vars/trust_anchors/vault.yml

# Personal inventory overrides (e.g. ansible/inventory.local.ini with ansible_user)
*.local.ini
*.local.yml
*.local.yaml

# Migration scripts and working data
migration/

# Runtime data generated on the host — not committed.
# Signing keys are generated by Lighthouse on first boot.
lighthouse/data/signing/*
lighthouse/data/storage/*
caddy/data/*
caddy/config/*

# Keep the directory stubs in git so the repo structure is self-describing.
!lighthouse/data/signing/.gitkeep
!lighthouse/data/storage/.gitkeep
!caddy/data/.gitkeep
!caddy/config/.gitkeep
