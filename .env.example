# ---------------------------------------------------------------------------
# Lighthouse Trust Anchor – environment variables
# Copy this file to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
#
# For Ansible deployments the .env file is rendered on the remote host
# from ansible/roles/lighthouse/templates/env.j2 using values stored in
# an Ansible Vault file (ansible/group_vars/vault.yml).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PostgreSQL credentials
# Consumed by the `postgres` service and forwarded to Lighthouse.
# ---------------------------------------------------------------------------
POSTGRES_USER=lighthouse
POSTGRES_DB=lighthouse
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ---------------------------------------------------------------------------
# Lighthouse storage password — must equal POSTGRES_PASSWORD above.
# Passed to Lighthouse via LH_STORAGE_PASSWORD so the password is never
# stored in config.yaml.
# ---------------------------------------------------------------------------
LH_STORAGE_PASSWORD=CHANGE_ME_strong_random_password
